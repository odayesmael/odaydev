# Contact form (/api/contact) — set these in Vercel → Project → Settings → Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Inbox that receives the briefs (default: info@oday.dev)
CONTACT_TO=info@oday.dev
# Sender on a domain verified in Resend (default: Resend's shared test sender)
CONTACT_FROM=oday.dev <hello@oday.dev>
